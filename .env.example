# NOTE: Prefer setting these in the `environment` section of your docker-compose.yml
# rather than a .env file, to avoid conflicts with host environment variables.
# See the README for a full compose example.

# ── Required: API credentials (never stored in DB) ───────────────────────────
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=your_tautulli_api_key

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key

# ── Required: Secret key ──────────────────────────────────────────────────────
# Used to sign session cookies and encrypt OIDC client secrets stored in the DB.
# Generate with: openssl rand -base64 32
SECRET_KEY=change-me-to-a-random-secret

# ── Optional ──────────────────────────────────────────────────────────────────
# Full URL Episode Guard is reachable at (used for OIDC redirect URIs).
# Must match what your OIDC provider has whitelisted.
# Default: http://localhost:8988
APP_URL=http://episodeguard.yourdomain.com

# Path inside container for SQLite DB. Default: /data
DATA_DIR=/data

# Note: poll interval, lookahead, season end buffer, log retention, webhook mode,
# webhook secret, session length, OIDC providers, and Apprise notifications are
# all configurable via the Settings page in the UI. Defaults are applied on first run.

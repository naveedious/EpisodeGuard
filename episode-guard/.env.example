# ── Required: API credentials (never stored in DB) ───────────────────────
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=your_tautulli_api_key

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key

# ── Web UI basic auth ─────────────────────────────────────────────────────
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# ── Optional ──────────────────────────────────────────────────────────────
# Path inside container for SQLite DB. Default: /data
DATA_DIR=/data

# Note: poll interval, lookahead, season end buffer, quality profile,
# and root folder are all configurable via the Settings page in the UI.
# Defaults are applied on first run.
